# Client statistics (Andromeda) — configuration template.
# Copy to .env in this folder and fill in:   cp .env.example .env
# .env is git-ignored. This file is committed — placeholders only.

# ── Andromeda production PostgreSQL ──────────────────────────
ANDROMEDA_DB_HOST=psql-and2-prod.postgres.database.azure.com
ANDROMEDA_DB_PORT=5432
ANDROMEDA_DB_NAME=postgres
ANDROMEDA_DB_USER=psqladmin
ANDROMEDA_DB_PASSWORD=
ANDROMEDA_DB_SSLMODE=require
