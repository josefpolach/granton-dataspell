# SDESK export — configuration template.
# Copy to .env in this folder and fill in:   cp .env.example .env
# .env is git-ignored. This file is committed — placeholders only.
#
# NOTE: JIRA_* is duplicated in KPIs/.env — Atlassian tokens are
# account-scoped, so both notebooks share one credential. Rotate BOTH files
# together.
# Token: https://id.atlassian.com/manage-profile/security/api-tokens

# ── Atlassian / Jira ─────────────────────────────────────────
JIRA_DOMAIN=grantoncz.atlassian.net
JIRA_EMAIL=you@granton.cz
JIRA_TOKEN=
JIRA_PROJECT=SDESK

# ── Google Drive integration API ─────────────────────────────
# NOTE: default points at UAT, not production.
GDRIVE_API_BASE_URL=https://integration-gdrive.uat.cloud.granton.ai
GDRIVE_FOLDER_ID=
GDRIVE_CLIENT_ID=
